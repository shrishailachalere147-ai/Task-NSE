{
  "name": "nse-playwright-automation",
  "version": "1.0.0",
  "description": "Playwright automation framework for NSE India Live Equity Market",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:ui": "playwright test --ui",
    "lint": "eslint tests/ pages/ utils/ --ext .ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  },
  "keywords": ["playwright", "automation", "nse", "testing"],
  "author": "QA Engineer",
  "license": "MIT"
}
